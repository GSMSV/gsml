# ─── Core ───────────────────────────────────────────────
APP_TIMEZONE=Asia/Seoul
CORS_ORIGINS=http://localhost:5173

# ─── Upstream LLM (llama-server or vLLM) ───────────────
UPSTREAM_BASE_URL=http://host.docker.internal:8080
UPSTREAM_TIMEOUT=600

# ─── DataGSM OAuth ─────────────────────────────────────
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback
OAUTH_AUTH_BASE=https://oauth.authorization.datagsm.kr
OAUTH_RESOURCE_BASE=https://oauth.resource.datagsm.kr

# ─── JWT ───────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=24

# ─── API Key ───────────────────────────────────────────
API_KEY_EXPIRE_DAYS=30

# ─── Defaults for new users ────────────────────────────
# 1일 크레딧 한도 (토큰이 아님). 신규 유저에게만 적용되며, 기존 유저 한도는 자동 환산되지
# 않는다 — 바꾸려면 data/gsml.db에 직접 UPDATE.
DEFAULT_CREDIT_LIMIT=10.0
DEFAULT_MAX_CONCURRENT=1

# ─── Admin bootstrap ────────────────────────────────────
# 콤마로 구분된 이메일. 로그인 시 role이 admin으로 승격된다(최초 관리자 부트스트랩용).
# 이후 role 관리는 대시보드의 /admin 페이지에서 다른 관리자가 수행한다.
ADMIN_EMAILS=

# ─── Pricing (토큰 100만 개당 크레딧) ──────────────────
# cached input은 업스트림 KV 캐시 히트분 — 기본 무료
PRICE_INPUT_PER_1M=0.5
PRICE_CACHED_INPUT_PER_1M=0.0
PRICE_OUTPUT_PER_1M=1.0

# ─── Logs ──────────────────────────────────────────────
REQUEST_LOG_RETENTION_DAYS=30
CONVERSATION_LOG_DIR=/app/logs/conversations

# ─── Database ──────────────────────────────────────────
DATABASE_URL=sqlite:///./data/gsml.db
